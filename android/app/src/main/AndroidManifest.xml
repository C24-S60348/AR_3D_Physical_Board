<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permission required for AR -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Internet for loading remote GLB models -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- i-GB is an "AR Optional" app.

         Requiring ARCore makes Google Play hide the app from any device that
         does not declare the android.hardware.camera.ar system feature, which
         is how an Oppo A3 Pro and a Realme tablet ended up reporting "Your
         device isn't compatible with this version". Play also rejects a bundle
         that asks for com.google.ar.core "required" without this uses-feature,
         so the two must agree.

         Declaring both optional lets every phone install the app and use the
         notes, the board, and the quiz. checkArSupport() in lib/utils/ar_support.dart
         asks ARCore at runtime and the scanner explains itself when AR is
         unavailable, rather than opening a camera that cannot track. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <application
        android:label="i.-GB"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- "optional" matches the plugin's own default and the uses-feature
             above. Google Play Services for AR is then installed on demand,
             only on the devices that support it. -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional"
            tools:replace="android:value"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>
